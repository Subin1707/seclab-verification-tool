{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seclab.local/schemas/project.schema.json",
  "title": "SecLab project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "source_root", "specification_paths"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "specification_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "language": { "type": "string", "minLength": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "configuration": { "type": "object", "additionalProperties": true, "default": {} }
  }
}
