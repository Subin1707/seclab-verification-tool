{"schema_version":"1.0","id":"generic-integer-boolean-smt","name":"Generic integer and Boolean checks","requirements":[{"id":"REQ-RANGE","description":"The integer input stays in range.","type":"safety","property_ids":["PROP-RANGE","PROP-BOUND"]},{"id":"REQ-BOOLEAN","description":"A Boolean excluded middle expression is valid.","type":"functional","property_ids":["PROP-BOOLEAN"]}],"variables":[{"id":"value","domain":{"type":"integer","minimum":0,"maximum":10}},{"id":"enabled","domain":{"type":"boolean"}}],"constraints":[{"id":"CONSTRAINT-VALUE-RANGE","expression":"value >= 0 && value <= 10","requirement_ids":["REQ-RANGE"]}],"properties":[{"id":"PROP-RANGE","logic":"SMT","formula":"value >= 0","requirement_ids":["REQ-RANGE"]},{"id":"PROP-BOUND","logic":"SMT","formula":"value <= 5","requirement_ids":["REQ-RANGE"]},{"id":"PROP-BOOLEAN","logic":"SMT","formula":"enabled || !enabled","requirement_ids":["REQ-BOOLEAN"]}]}
